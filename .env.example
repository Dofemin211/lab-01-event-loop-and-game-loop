NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
ALLOWED_ORIGINS=https://localhost:8443
# Exact proxy socket IPs only; never trust forwarded headers from arbitrary peers.
TRUSTED_PROXY_IPS=
MAX_CONNECTIONS_PER_IP=100
MAX_ROOMS=50
MAX_PLAYERS_PER_ROOM=8
MAX_PAYLOAD_BYTES=16384
MAX_HTTP_BODY_BYTES=8192
MESSAGE_RATE_PER_SECOND=90
SLOW_CLIENT_BYTES=262144
JOIN_TIMEOUT_MS=5000
HEARTBEAT_INTERVAL_MS=15000
MAX_MISSED_HEARTBEATS=2
LOG_DIR=server/logs
CLIENT_DIST_DIR=client/dist

# Local Docker Compose example values (copy this file to .env before compose up).
DOMAIN=localhost
HTTPS_URL=https://localhost:8443
HTTP_BIND_PORT=8081
CADDY_HTTP_PORT=8081
HTTPS_BIND_PORT=8443
CADDY_HTTPS_PORT=8443
IMAGE_NAME=dogfight
IMAGE_TAG=local
