{
  "name": "dogfight-learning-labs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:client": "npm run dev --workspace @dogfight/client",
    "dev:server": "node --env-file-if-exists=.env --watch server/src/index.js",
    "build": "npm run build --workspace @dogfight/client",
    "start": "node --env-file-if-exists=.env server/src/index.js",
    "test": "npm run test:client && npm run test:server",
    "test:client": "npm run test --workspace @dogfight/client",
    "test:server": "npm run test --workspace @dogfight/server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "experiment:backpressure": "npm run experiment:backpressure --workspace @dogfight/server",
    "experiment:unsafe-backpressure": "npm run experiment:unsafe-backpressure --workspace @dogfight/server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0"
  }
}
