{
  "name": "dogfight-learning-labs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:client": "npm run dev --workspace @dogfight/client",
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "build": "npm run build --workspace @dogfight/client && npm run build:server",
    "build:server": "tsc -p tsconfig.server-build.json && node scripts/prepare-server-build.mjs",
    "start": "node --env-file-if-exists=.env --import ./scripts/production-env.mjs dist/server-runtime/server/src/index.js",
    "smoke:production": "npm run build && node scripts/production-smoke-test.mjs",
    "test:chaos": "npm run build && node --import tsx --test server/test/chaos.test.ts && node scripts/production-smoke-test.mjs",
    "test": "npm run test:node && npm run test:vitest",
    "test:node": "npm run test:shared && npm run test:client && npm run test:server",
    "test:vitest": "vitest run",
    "test:shared": "npm run test --workspace @dogfight/shared",
    "test:client": "npm run test --workspace @dogfight/client",
    "test:server": "npm run test --workspace @dogfight/server",
    "typecheck": "tsc --noEmit -p shared/tsconfig.json && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "c8 --all --include=shared/src/**/*.ts --reporter=text --reporter=json --reporter=json-summary --check-coverage --lines 85 --functions 85 --branches 85 --statements 85 npm test",
    "e2e": "npm run build && playwright test",
    "experiment:load": "tsx scripts/load-test.ts",
    "experiment:worker": "tsx scripts/worker-benchmark.ts",
    "experiment:browser-profile": "npm run build && tsx scripts/profile-browser.ts",
    "experiment:backpressure": "npm run experiment:backpressure --workspace @dogfight/server",
    "experiment:unsafe-backpressure": "npm run experiment:unsafe-backpressure --workspace @dogfight/server",
    "experiment:netcode": "tsx scripts/network-benchmark.ts",
    "experiment:profile": "tsx scripts/profile-server.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "c8": "^12.0.0",
    "eslint": "^10.0.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
