IMAGE_TAG=replace-with-full-commit-sha
DOMAIN=game.example.com
HTTPS_URL=https://game.example.com
HTTP_BIND_PORT=80
CADDY_HTTP_PORT=80
HTTPS_BIND_PORT=443
CADDY_HTTPS_PORT=443
ALLOWED_ORIGINS=https://game.example.com
LOG_LEVEL=info
MAX_CONNECTIONS_PER_IP=100
MAX_ROOMS=50
MAX_PLAYERS_PER_ROOM=8
